# Caddy 配置
#
# 站点域名从环境变量 SITE_ADDRESS 读取，不写死在这个文件里。
#
# 为什么要这么做：Caddyfile 是被 git 跟踪的。如果域名写死在这个文件里，
# 服务器上改过之后，每次 git pull 都会产生冲突——而更新简历是要经常 pull 的。
# 放到 .env（已被 .gitignore 排除）里就没有这个问题，换域名也只改一个地方。
#
# 在 .env 里设置 SITE_ADDRESS：
#   SITE_ADDRESS=resume-tmz.duckdns.org    正常上线，自动申请 HTTPS 证书
#   SITE_ADDRESS=:80                       还没有域名，临时用 IP + HTTP
#
# 想同时支持 www 子域，写逗号分隔的两个地址即可：
#   SITE_ADDRESS=resume.example.com, www.resume.example.com
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# 这是个人简历的问答页，不需要被搜索引擎收录
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy app:8080
}
