# 服务器上用的 .env 模板：复制成 .env 再填真实值
#   cp .env.production.example .env && nano .env
#
# ⚠️ 这个文件不要提交到 git（.gitignore 里已排除 .env，但请确认你复制出来的文件名就是 .env）

# ---- 必填：两个模型的密钥 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 模型配置 ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_PROVIDER=deepseek
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=openai:Pro/BAAI/bge-m3
EMBED_DIM=1024

# ---- 服务配置 ----
# 容器内监听的端口。保持 8080：
#   - 临时用 `docker run -p 80:8080` 直连时，靠的就是这个值
#   - 切到 docker compose 后，compose 里也固定为 8080，前后一致
# 不写这一行的话会落到代码默认值 7860，和端口映射对不上，浏览器打不开。
PORT=8080

HOST=0.0.0.0
# 单 IP 每分钟提问上限，防止链接被人刷爆额度
RATE_LIMIT_PER_MINUTE=20
MAX_QUESTION_CHARS=500
RETRIEVE_TOP_K=4

# 跨域白名单：换成你的域名，别用 *（前端和接口同源，本来也不需要跨域）
CORS_ORIGINS=https://resume.example.com
